{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  },
  "crons": [
    {
      "path": "/api/scheduled-reports/process",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/scheduled-pipelines/execute",
      "schedule": "*/5 * * * *"
    }
  ]
}