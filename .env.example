# BlogCanvas Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# PORT CONFIGURATION
# ===========================================
PORT=4848
POSTGRES_PORT=5432

# ===========================================
# APP CONFIGURATION
# ===========================================
# Your application URL (used for OAuth callbacks, email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:4848

# Allow user registration (set to 'false' to disable public signup)
NEXT_PUBLIC_ALLOW_REGISTRATION=true
ALLOW_REGISTRATION=true

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# For local Docker development (optional - uses local PostgreSQL)
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# DATABASE_URL=postgresql://postgres:postgres@db:5432/blogcanvas

# ===========================================
# OPENAI API (REQUIRED for AI features)
# ===========================================
OPENAI_API_KEY=your_openai_api_key

# ===========================================
# STRIPE (OPTIONAL - for billing/payments)
# ===========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ===========================================
# RESEND (OPTIONAL - for transactional emails)
# ===========================================
RESEND_API_KEY=your_resend_api_key
RESEND_DOMAIN=blogcanvas.io

# ===========================================
# GOOGLE OAUTH (OPTIONAL - for Gmail/GA4/GSC integrations)
# ===========================================
# Gmail Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4848/api/gmail/callback

# Google Search Console (optional)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your_gsc_client_id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your_gsc_client_secret
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=your_gsc_refresh_token

# ===========================================
# SECURITY
# ===========================================
# Two-Factor Authentication (2FA/TOTP) - REQUIRED for 2FA feature
# Generate a new encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your_64_character_hex_key_here

# ===========================================
# SENTRY (OPTIONAL - for error monitoring)
# ===========================================
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# ===========================================
# TESTING (OPTIONAL - for automated tests)
# ===========================================
# Test user credentials (for E2E tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test_password_123

# ===========================================
# CI/CD (OPTIONAL)
# ===========================================
# Set to true when running in CI environment
# CI=true

# ===========================================
# BROWSERBASE (OPTIONAL - for website scanning)
# ===========================================
# Cloud browser for web scraping - https://browserbase.com
BROWSERBASE_API_KEY=your_browserbase_api_key

# ===========================================
# DOCKER CONFIGURATION (OPTIONAL)
# ===========================================
# Uncomment and modify if running via Docker
# DOCKER_APP_PORT=4848
# DOCKER_DB_PORT=5432
