# BlogCanvas Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# PORT CONFIGURATION
# ===========================================
PORT=4848
POSTGRES_PORT=5432

# ===========================================
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# For local Docker development (optional - uses local PostgreSQL)
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# DATABASE_URL=postgresql://postgres:postgres@db:5432/blogcanvas

# OpenAI API (for AI content generation)
OPENAI_API_KEY=your_openai_api_key

# Stripe (for billing - optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend (for transactional emails - optional)
RESEND_API_KEY=your_resend_api_key

# Gmail Integration (optional)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# ===========================================
# DOCKER CONFIGURATION (optional)
# ===========================================
# Uncomment and modify if running via Docker
# DOCKER_APP_PORT=4848
# DOCKER_DB_PORT=5432
