    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-server-dom-webpack": "^19.2.1",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
