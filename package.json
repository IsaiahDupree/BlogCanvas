{
  "name": "blog-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4848",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test visual-regression.spec.ts",
    "test:visual:update": "playwright test visual-regression.spec.ts --update-snapshots",
    "test:load": "k6 run __tests__/performance/k6-load-test.js",
    "test:load:critical": "k6 run __tests__/performance/k6-critical-paths.js",
    "test:load:spike": "k6 run --vus 100 --duration 5m __tests__/performance/k6-load-test.js",
    "test:supabase": "tsx scripts/test-supabase-connection.ts",
    "test:seed": "tsx scripts/seed-test-data.ts",
    "migrations:list": "tsx scripts/manage-migrations.ts list",
    "migrations:status": "tsx scripts/manage-migrations.ts status",
    "migrations:apply": "tsx scripts/manage-migrations.ts apply",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:backup:staging": "tsx scripts/backup-database.ts --env=staging",
    "db:restore": "tsx scripts/restore-database.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "docs:schema": "tsx scripts/generate-schema-docs.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:prod": "npm audit --production --audit-level=critical",
    "security:fix": "npm audit fix",
    "security:report": "npm audit --json > security-audit.json && cat security-audit.json | jq '.metadata'",
    "harness": "node harness/run-harness-v2.js",
    "harness:continuous": "node harness/run-harness-v2.js --continuous",
    "harness:20hr": "node harness/run-harness-v2.js --continuous --max=200"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.39.0",
    "@stripe/stripe-js": "^8.8.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "diff": "^8.0.3",
    "googleapis": "^170.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "openai": "^6.22.0",
    "otpauth": "^9.5.0",
    "pg": "^8.18.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.2",
    "stripe": "^20.3.1",
    "swagger-ui-react": "^5.31.2",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/diff": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
