# BlogCanvas Staging Environment Configuration
# Copy this to .env.staging.local and fill in actual values

# App Configuration
NODE_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.blogcanvas.com
PORT=4848

# Supabase (Staging Project)
NEXT_PUBLIC_SUPABASE_URL=your-staging-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_JWT_SECRET=your-staging-jwt-secret

# Database (Staging)
DATABASE_URL=postgresql://user:password@staging-db-host:5432/blogcanvas_staging

# Stripe (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_pk_test_STAGING_KEY
STRIPE_SECRET_KEY=REPLACE_sk_test_STAGING_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_whsec_STAGING_WEBHOOK

# Email (Resend - Test Mode)
RESEND_API_KEY=REPLACE_re_STAGING_KEY
RESEND_FROM_EMAIL=staging@blogcanvas.com

# OpenAI (Lower rate limits for staging)
OPENAI_API_KEY=REPLACE_sk_STAGING_KEY
OPENAI_ORG_ID=REPLACE_org_STAGING_ORG

# Google APIs (Staging credentials)
GOOGLE_CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-client-secret
GOOGLE_REDIRECT_URI=https://staging.blogcanvas.com/api/auth/google/callback

# Google Analytics (Staging property)
GA_MEASUREMENT_ID=G-STAGING123
GA_PROPERTY_ID=properties/staging123

# Google Search Console (Staging)
GSC_CLIENT_ID=your-staging-gsc-client-id
GSC_CLIENT_SECRET=your-staging-gsc-client-secret

# Sentry (Staging environment)
SENTRY_DSN=https://your-staging-dsn@sentry.io/project
SENTRY_ENVIRONMENT=staging
SENTRY_AUTH_TOKEN=your-staging-auth-token

# Rate Limiting (More permissive for testing)
UPSTASH_REDIS_REST_URL=https://your-staging-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-staging-token

# Feature Flags (Staging can test new features)
ENABLE_BETA_FEATURES=true
ENABLE_DEBUG_MODE=true
ENABLE_PERFORMANCE_MONITORING=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
JWT_SECRET=your-staging-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-staging-encryption-key-32-chars
SESSION_SECRET=your-staging-session-secret

# Webhooks
WEBHOOK_SECRET=your-staging-webhook-secret

# Storage (Supabase Storage - Staging bucket)
NEXT_PUBLIC_STORAGE_BUCKET=blogcanvas-staging
STORAGE_MAX_FILE_SIZE=10485760

# AI Pipeline (Reduced limits for staging)
MAX_CONCURRENT_AI_JOBS=3
AI_TIMEOUT_MS=60000

# Testing
PLAYWRIGHT_TEST_BASE_URL=https://staging.blogcanvas.com
E2E_TEST_USER_EMAIL=test@blogcanvas.com
E2E_TEST_USER_PASSWORD=testpass123

# Preview URLs (for PR deployments)
VERCEL_URL=auto-generated-by-vercel
VERCEL_GIT_COMMIT_SHA=auto-generated-by-vercel
